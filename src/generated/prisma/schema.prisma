generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────
// ENUMS GLOBAUX
// ─────────────────────────────────────────

// GlobalRole enum removed to use String instead to avoid DB type conflicts

enum SpaceRole {
  ADMIN // créateur de l'espace
  MODERATOR // nommé par l'admin
  MEMBER // accès via OTP
}

enum MemberStatus {
  ACTIVE
  WARNED
  BLOCKED
}

enum RecordingStatus {
  PENDING
  TRANSCRIBED
  SUMMARIZED
  EXPORTED
}

enum MessageType {
  TEXT
  FILE
  AUDIO
  IMAGE
  SYSTEM
}

enum NotificationType {
  MENTION
  WARNING
  PIN
  NEW_MESSAGE
  SYSTEM
}

// ─────────────────────────────────────────
// USER
// ─────────────────────────────────────────

model User {
  id        String   @id
  email     String   @unique
  name      String?
  avatar    String?
  bio       String?
  phone     String?
  role      String   @default("SECRETAIRE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Afriland Record
  recordings Recording[]

  // Afriland Room
  createdMeetings  Meeting[]         @relation("MeetingCreator")
  meetingAttendees MeetingAttendee[]

  // Afriland Space
  ownedSpaces      Space[]       @relation("SpaceOwner")
  spaceMemberships SpaceMember[]
  createdChannels  Channel[]     @relation("ChannelCreator")
  messages         Message[]
  sentOtpInvites   OtpInvite[]   @relation("OtpSender")
  issuedWarnings   Warning[]     @relation("WarningIssuer")
}

// ─────────────────────────────────────────
// 1. AFRILAND RECORD
// ─────────────────────────────────────────

model Recording {
  id             String          @id @default(cuid())
  title          String
  audioUrl       String
  duration       Int?
  transcription  String?         @db.Text
  summary        String?         @db.Text
  status         RecordingStatus @default(PENDING)
  exportedPdfUrl String?
  language       String          @default("fr")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  createdBy User   @relation(fields: [userId], references: [id])
  userId    String

  @@index([userId])
}

// ─────────────────────────────────────────
// 2. AFRILAND ROOM
// ─────────────────────────────────────────

model Room {
  id          String   @id @default(cuid())
  name        String
  capacity    Int      @default(20)
  location    String?
  description String?
  color       String   @default("#1f1f1f")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  meetings Meeting[]
}

model Meeting {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  startTime   DateTime
  endTime     DateTime
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  room   Room   @relation(fields: [roomId], references: [id])
  roomId String

  createdBy User   @relation("MeetingCreator", fields: [userId], references: [id])
  userId    String

  attendees MeetingAttendee[]

  @@index([roomId])
  @@index([startTime, endTime])
}

model MeetingAttendee {
  id        String   @id @default(cuid())
  name      String?
  email     String?
  isPresent Boolean  @default(false)
  createdAt DateTime @default(now())

  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  meetingId String

  user   User?   @relation(fields: [userId], references: [id])
  userId String?

  @@unique([meetingId, userId])
  @@index([meetingId])
}

// ─────────────────────────────────────────
// 3. AFRILAND SPACE
// ─────────────────────────────────────────

model Space {
  id          String   @id @default(cuid())
  name        String
  description String?
  icon        String?
  objective   String?
  adminRole   String // rôle AFB du créateur ex: "Responsable Comptabilité"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner   User   @relation("SpaceOwner", fields: [ownerId], references: [id])
  ownerId String

  members    SpaceMember[]
  channels   Channel[]
  otpInvites OtpInvite[]

  @@index([ownerId])
}

model SpaceMember {
  id           String       @id @default(cuid())
  role         SpaceRole    @default(MEMBER)
  status       MemberStatus @default(ACTIVE)
  joinedAt     DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  blockedUntil DateTime?

  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  spaceId String
  user    User   @relation(fields: [userId], references: [id])
  userId  String

  warnings      Warning[]
  notifications Notification[]

  @@unique([spaceId, userId])
  @@index([spaceId])
  @@index([userId])
}

model Warning {
  id        String   @id @default(cuid())
  reason    String
  createdAt DateTime @default(now())

  member   SpaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId String

  issuedBy User   @relation("WarningIssuer", fields: [userId], references: [id])
  userId   String

  @@index([memberId])
}

model Channel {
  id          String   @id @default(cuid())
  name        String
  description String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  spaceId String

  createdBy User   @relation("ChannelCreator", fields: [userId], references: [id])
  userId    String

  messages      Message[]
  notifications Notification[]

  @@unique([spaceId, name])
  @@index([spaceId])
}

model Message {
  id        String      @id @default(cuid())
  content   String      @db.Text
  type      MessageType @default(TEXT)
  fileUrl   String?
  isPinned  Boolean     @default(false)
  pinnedAt  DateTime?
  editedAt  DateTime?
  createdAt DateTime    @default(now())

  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  channelId String

  sender User   @relation(fields: [userId], references: [id])
  userId String

  replyTo   Message?  @relation("MessageReplies", fields: [replyToId], references: [id])
  replyToId String?
  replies   Message[] @relation("MessageReplies")

  notifications Notification[]

  @@index([channelId])
  @@index([userId])
}

model OtpInvite {
  id        String    @id @default(cuid())
  email     String
  code      String    @unique
  expiresAt DateTime // now() + 2 minutes à la création
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  spaceId String

  sentBy User   @relation("OtpSender", fields: [userId], references: [id])
  userId String

  @@index([email])
  @@index([code])
  @@index([spaceId])
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  member   SpaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId String

  channel   Channel? @relation(fields: [channelId], references: [id])
  channelId String?

  message   Message? @relation(fields: [messageId], references: [id])
  messageId String?

  @@index([memberId])
  @@index([channelId])
}
